# EVOLUTION TRACKER 2.0 - Configuration Example
# Copy this file to .env to configure local settings.
# The application runs fully functional in Demonstration Mode with ZERO external API keys.

# Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (Defaults to modular SQLite database)
DATABASE_URL=sqlite:///./evolution_tracker.db

# External Search Providers (Optional - If unset, fallback demo/mock mode is clearly shown)
# SERPAPI_API_KEY=
# TAVILY_API_KEY=

# LLM Providers (Optional - Rule-based NLP extraction & evidence verification runs 100% locally if unset)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash
# OPENAI_API_KEY=
